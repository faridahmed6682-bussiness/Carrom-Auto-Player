<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher manifest for the Carrom-Auto-Player standalone export.
  Package comes from the `namespace` in app/build.gradle.kts (com.example);
  applicationId is com.example.carromautoplayer.
  No permissions: the exported carrom engine needs none — no camera,
  no internet, no accessibility service, no overlay. The calibration
  dialog uses the system photo picker (no permission needed).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Carrom Auto Player"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name="com.example.game.CarromMainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
